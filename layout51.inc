/* First-start copy migration. Originals and existing destination files are retained. */
static unsigned layout51_copied,layout51_failed;
static void layout51_copy(const wchar_t*old,const wchar_t*dest){if(CopyFileW(old,dest,TRUE))layout51_copied++;else{DWORD e=GetLastError();if(e!=ERROR_FILE_EXISTS&&e!=ERROR_ALREADY_EXISTS&&e!=ERROR_FILE_NOT_FOUND&&e!=ERROR_PATH_NOT_FOUND)layout51_failed++;}}
static void layout51_dircopy(const wchar_t*old,const wchar_t*dest,const wchar_t*pattern){wchar_t search[32768],a[32768],b[32768];swprintf(search,32768,L"%ls\\%ls",old,pattern);WIN32_FIND_DATAW data;HANDLE f=FindFirstFileW(search,&data);if(f==INVALID_HANDLE_VALUE)return;CreateDirectoryW(dest,NULL);do{if(data.dwFileAttributes&(FILE_ATTRIBUTE_DIRECTORY|FILE_ATTRIBUTE_REPARSE_POINT))continue;swprintf(a,32768,L"%ls\\%ls",old,data.cFileName);swprintf(b,32768,L"%ls\\%ls",dest,data.cFileName);layout51_copy(a,b);}while(FindNextFileW(f,&data));FindClose(f);}
static int layout51_init(wchar_t*path){wchar_t bin[32768],root[32768],legacy[32768],a[32768],b[32768];if(wcslen(path)>31000)return 0;wcscpy(bin,path);swprintf(root,32768,L"%ls\\IGM",bin);if(!CreateDirectoryW(root,NULL)&&GetLastError()!=ERROR_ALREADY_EXISTS)return 0;swprintf(path,32768,L"%ls\\IGM_datos",root);if(!CreateDirectoryW(path,NULL)&&GetLastError()!=ERROR_ALREADY_EXISTS)return 0;swprintf(legacy,32768,L"%ls\\IGM_v031_datos",bin);
 const wchar_t*names[][2]={{L"catalogo_observado.jsonl",L"catalogo_observado.jsonl"},{L"gestion_sistemas.tsv",L"gestion_sistemas.tsv"},{L"exploracion_v045.tsv",L"exploracion.tsv"},{L"colores_alianzas.tsv",L"colores_alianzas.tsv"},{L"ajustes_v045.ini",L"ajustes.ini"},{L"captura_v050.ini",L"captura.ini"}};
 for(size_t i=0;i<sizeof(names)/sizeof(*names);i++){swprintf(a,32768,L"%ls\\%ls",legacy,names[i][0]);swprintf(b,32768,L"%ls\\%ls",path,names[i][1]);layout51_copy(a,b);}
 swprintf(a,32768,L"%ls\\IGM_v031.ini",bin);swprintf(b,32768,L"%ls\\IGM.ini",path);layout51_copy(a,b);
 swprintf(a,32768,L"%ls\\capturas_prueba_v050",legacy);swprintf(b,32768,L"%ls\\capturas",path);layout51_dircopy(a,b,L"*.bmp");CreateDirectoryW(b,NULL);
 swprintf(a,32768,L"%ls\\iconos_alianzas",legacy);swprintf(b,32768,L"%ls\\iconos_alianzas",path);layout51_dircopy(a,b,L"*.igmicon");return 1;}
