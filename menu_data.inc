#include "catalogue_management.h"
static Management management,management_staged;
static SRWLOCK management_lock=SRWLOCK_INIT;
static int management_writable=1;
static int is_excluded(uint64_t ua){if(imperial53_find(ua))return 0;AcquireSRWLockShared(&management_lock);int i=managed_find(&management,ua);int yes=i>=0&&(management.entries[i].flags&2);ReleaseSRWLockShared(&management_lock);return yes;}
static ManagedSystem metadata(uint64_t ua){ManagedSystem s={0};s.ua=ua;AcquireSRWLockShared(&management_lock);int i=managed_find(&management,ua);if(i>=0)s=management.entries[i];ReleaseSRWLockShared(&management_lock);const Imperial53System *core=imperial53_find(ua);if(core){s.flags&=~2u;snprintf(s.name,128,"%s",core->name);}return s;}
static int persist_management(const Management *m){wchar_t path[32768],tmp[32768];make_path(path,L"gestion_sistemas.tsv");make_path(tmp,L"gestion_sistemas.tsv.tmp");HANDLE h=CreateFileW(tmp,GENERIC_WRITE,0,NULL,CREATE_ALWAYS,FILE_ATTRIBUTE_NORMAL,NULL);if(h==INVALID_HANDLE_VALUE)return 0;int ok=write_handle(h,"# IGM37 ua flags planets name_utf8_hex\r\n");for(size_t i=0;ok&&i<m->count;i++){char line[400];managed_format(&m->entries[i],line);ok=write_handle(h,line);}if(ok)ok=FlushFileBuffers(h)!=0;CloseHandle(h);if(ok)ok=MoveFileExW(tmp,path,MOVEFILE_REPLACE_EXISTING|MOVEFILE_WRITE_THROUGH)!=0;if(!ok)DeleteFileW(tmp);return ok;}
static int management_change(uint64_t ua,int action,unsigned planet,const char *name){if(imperial53_find(ua)&&(action==2||name))return 0;if(!management_writable)return 0;AcquireSRWLockExclusive(&management_lock);management_staged=management;int ok=1;ManagedSystem *s=managed_get(&management_staged,ua);if(!s)ok=0;else if(name){snprintf(s->name,sizeof(s->name),"%s",name);}else ok=managed_action(&management_staged,ua,action,planet);if(ok)ok=persist_management(&management_staged);if(ok)management=management_staged;ReleaseSRWLockExclusive(&management_lock);log_line("MANAGEMENT ua=%016llx action=%d persisted=%d",(unsigned long long)ua,action,ok);return ok;}
static void load_management(void){wchar_t path[32768];make_path(path,L"gestion_sistemas.tsv");FILE *f=_wfopen(path,L"rb");if(!f){if(GetFileAttributesW(path)!=INVALID_FILE_ATTRIBUTES){management_writable=0;log_line("MANAGEMENT existing file unreadable; preserved");}return;}char line[512];while(fgets(line,sizeof(line),f)){if(line[0]=='#')continue;ManagedSystem s;if(!managed_parse(line,&s)){management_writable=0;continue;}ManagedSystem *d=managed_get(&management,s.ua);if(d)*d=s;}fclose(f);log_line("MANAGEMENT loaded=%zu writable=%d",management.count,management_writable);}
static void alliance_label(const uint32_t id[4],char out[180]){char name[128]={0},initials[7]={0};AcquireSRWLockShared(&labels_lock);for(size_t i=0;i<label_count;i++)if(!memcmp(labels[i].id,id,16)){snprintf(name,sizeof(name),"%s",labels[i].name);snprintf(initials,sizeof(initials),"%s",labels[i].text);break;}ReleaseSRWLockShared(&labels_lock);if(own_id(id))snprintf(out,180,"Imperio Español");else snprintf(out,180,"%s%s%s%s",name[0]?name:"Alianza con nombre pendiente",initials[0]?" (":"",initials,initials[0]?")":"");}
